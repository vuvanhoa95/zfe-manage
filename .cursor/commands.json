{
  "commands": [
    {
      "name": "Quick Commit",
      "description": "Commit changes với message tự động",
      "command": "powershell -ExecutionPolicy Bypass -File ./quick-commit.ps1",
      "category": "Git"
    },
    {
      "name": "Quick Commit & Push",
      "description": "Commit và push lên GitHub (trigger auto-deploy)",
      "command": "powershell -ExecutionPolicy Bypass -File ./quick-commit.ps1 --push",
      "category": "Git"
    },
    {
      "name": "Commit với message",
      "description": "Commit với message tùy chỉnh",
      "command": "powershell -ExecutionPolicy Bypass -File ./quick-commit.ps1 \"{input}\"",
      "category": "Git",
      "requiresInput": true,
      "inputPrompt": "Nhập commit message:"
    },
    {
      "name": "Deploy Production",
      "description": "Deploy lên Vercel production",
      "command": "powershell -ExecutionPolicy Bypass -File ./deploy-production.ps1",
      "category": "Deploy"
    },
    {
      "name": "Deploy Production (Skip Build)",
      "description": "Deploy production bỏ qua build test",
      "command": "powershell -ExecutionPolicy Bypass -File ./deploy-production.ps1 --skip-build",
      "category": "Deploy"
    },
    {
      "name": "Build Project",
      "description": "Build project để test",
      "command": "npm run build",
      "category": "Build"
    },
    {
      "name": "Start Dev Server",
      "description": "Chạy development server",
      "command": "npm run dev",
      "category": "Development"
    },
    {
      "name": "Run Linter",
      "description": "Chạy ESLint để kiểm tra code",
      "command": "npm run lint",
      "category": "Code Quality"
    },
    {
      "name": "Generate Prisma Client",
      "description": "Generate Prisma Client sau khi thay đổi schema",
      "command": "npx prisma generate",
      "category": "Database"
    },
    {
      "name": "Run Migrations",
      "description": "Chạy database migrations",
      "command": "npx prisma migrate deploy",
      "category": "Database"
    },
    {
      "name": "Git Status",
      "description": "Xem trạng thái Git",
      "command": "git status",
      "category": "Git"
    },
    {
      "name": "Git Pull",
      "description": "Pull code từ remote",
      "command": "git pull origin main",
      "category": "Git"
    },
    {
      "name": "Git Log",
      "description": "Xem lịch sử commits",
      "command": "git log --oneline -10",
      "category": "Git"
    },
    {
      "name": "Check Vercel Status",
      "description": "Kiểm tra trạng thái Vercel project",
      "command": "vercel project ls",
      "category": "Deploy"
    },
    {
      "name": "Pull Env Variables",
      "description": "Pull environment variables từ Vercel",
      "command": "vercel env pull .env.local",
      "category": "Deploy"
    }
  ]
}
