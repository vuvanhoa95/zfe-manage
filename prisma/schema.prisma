generator client {
  provider = "prisma-client-js"
}

datasource db {
  /// PostgreSQL cho cả development và production
  /// Development: Dùng Neon free tier (hoặc local PostgreSQL)
  /// Production (Vercel): Dùng Neon pooled connection
  ///
  /// DATABASE_URL format: postgresql://user:pass@host/dbname?sslmode=require
  /// DIRECT_URL format:   postgresql://user:pass@host/dbname?sslmode=require (non-pooled, cho migrations)
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  name               String?
  role               String              @default("USER")
  status             UserStatus          @default(PENDING)
  /// Chức danh công việc (ví dụ: Kỹ sư, Trưởng phòng, Giám đốc)
  title              String?
  /// Bộ môn chuyên môn (ví dụ: Kiến trúc, Kết cấu, MEP)
  department         String?
  /// Kinh nghiệm làm việc (số năm hoặc mô tả)
  experience         String?
  /// Số tài khoản ngân hàng
  bankAccount        String?
  /// Mã số thuế cá nhân
  taxCode            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  sessions           Session[]
  cashFlows          CashFlow[]
  projects           Project[]
  quotationRevisions QuotationRevision[]
  quotations         Quotation[]
  quotationTemplates QuotationTemplate[]
  customFieldValues  CustomFieldValue[]
  assignedTasks      Task[]              @relation("TaskAssignee")
  taskComments       TaskComment[]
  taskAttachments    TaskAttachment[]
  projectMembers     ProjectMember[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CompanyProfile {
  id            Int      @id @default(1)
  name          String
  taxCode       String
  address       String
  email         String
  website       String?
  phone         String
  logoUrl       String?
  projectSlogan String?
  signerName    String
  signerTitle   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("company_profile")
}

model Customer {
  id          String      @id @default(uuid())
  name        String
  taxCode     String?
  address     String?
  /// Địa điểm chính của khách hàng (thành phố/tỉnh)
  location    String?
  contactName String?
  email       String?
  phone       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  projects    Project[]
  quotations  Quotation[]

  @@map("customers")
}

model Project {
  id               String          @id @default(uuid())
  projectNo        String          @unique
  name             String
  code             String?
  description      String?
  customerId       String?
  location         String          @default("Hà Nội")
  startDate        DateTime?
  endDate          DateTime?
  totalArea        Float?
  totalBudget      Float           @default(0)
  totalRevenue     Float           @default(0)
  totalCost        Float           @default(0)
  totalProfit      Float           @default(0)
  status           String          @default("PLANNING")
  notes            String?
  imageUrl         String?
  /// Danh sách giai đoạn triển khai (JSON array of strings), VD: ["Thiết kế cơ sở","Shopdrawing","Thi công"]
  phases           String?
  /// Danh sách bộ môn (JSON array), VD: ["Kiến trúc","Kết cấu","MEP","Điện","Nước"]
  disciplines      String?
  /// Danh sách khu vực/vị trí (JSON array), VD: ["Tầng hầm 1","Tầng 1","Mái","Block A"]
  areas            String?
  /// Danh sách tầng/level BIM (JSON array), VD: ["01BS","01FL","02-05FL","RF"]
  levels           String?
  createdById      String
  finalQuotationId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  cashFlows        CashFlow[]
  createdBy        User            @relation(fields: [createdById], references: [id])
  customer         Customer?       @relation(fields: [customerId], references: [id])
  finalQuotation   Quotation?      @relation("FinalQuotation", fields: [finalQuotationId], references: [id])
  quotations       Quotation[]
  tasks            Task[]
  members          ProjectMember[]

  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([projectNo])
  @@map("projects")
}

model CashFlow {
  id                      String            @id @default(uuid())
  projectId               String
  type                    String
  category                String?
  description             String
  amount                  Float
  date                    DateTime
  quotationId             String?
  paymentMilestoneNo      Int?
  paymentMilestonePercent Float?
  paymentMilestoneTitle   String?
  outsourcingStaffId      String?
  counterpartyName        String?
  notes                   String?
  /// Tình trạng hồ sơ thanh toán cho đợt thu/chi này
  /// Giá trị gợi ý: NONE | SUBMITTED | APPROVED | REJECTED
  documentStatus          String?
  /// Ghi chú chi tiết về hồ sơ (số hóa đơn, nội dung bổ sung...)
  documentNote            String?
  createdById             String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  createdBy               User              @relation(fields: [createdById], references: [id])
  outsourcingStaff        OutsourcingStaff? @relation(fields: [outsourcingStaffId], references: [id])
  project                 Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotation               Quotation?        @relation(fields: [quotationId], references: [id])

  @@index([projectId])
  @@index([date])
  @@index([type])
  @@index([quotationId])
  @@index([outsourcingStaffId])
  @@map("cash_flows")
}

model Quotation {
  id                  String                   @id @default(uuid())
  quotationNo         String                   @unique
  projectId           String
  date                DateTime
  location            String                   @default("Hà Nội")
  customerId          String
  projectName         String
  projectItem         String?
  projectNotes        String?
  totalArea           Float?
  title               String                   @default("BÁO GIÁ DỊCH VỤ MÔ HÌNH BIM")
  introText           String?
  scopeText           String?
  deliverablesText    String                   @default("")
  scheduleText        String?
  currency            String                   @default("VND")
  vatRate             Float                    @default(0.08)
  totalBeforeVat      Float                    @default(0)
  vatAmount           Float                    @default(0)
  totalAfterVat       Float                    @default(0)
  totalInWords        String?
  outsourceCost       Float?
  outsourceStaff      String?
  outsourceDiscipline String?
  outsourceRate       Float?
  outsourceNote       String?
  taxRate             Float?
  taxCost             Float?
  commissionType      String?
  commissionRate      Float?
  commissionCost      Float?
  status              String                   @default("DRAFT")
  notes               String?
  /// UI theme for preview/export (e.g. blue/green/red or hex color)
  theme               String?
  createdById         String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  cashFlows           CashFlow[]
  paymentMilestones   PaymentMilestone[]
  finalForProject     Project?                 @relation("FinalQuotation")
  lines               QuotationLine[]
  outsourceLines      QuotationOutsourceLine[]
  revisions           QuotationRevision[]
  createdBy           User                     @relation(fields: [createdById], references: [id])
  customer            Customer                 @relation(fields: [customerId], references: [id])
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([quotationNo])
  @@map("quotations")
}

model QuotationOutsourceLine {
  id          String    @id @default(uuid())
  quotationId String
  staffName   String?
  discipline  String?
  unit        String?
  qty         Float?
  unitRate    Float?
  amount      Float     @default(0)
  note        String?
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_outsource_lines")
}

model QuotationLine {
  id            String    @id @default(uuid())
  quotationId   String
  section       String?
  itemNo        String?
  title         String
  qty           Float?
  unit          String?
  unitPrice     Float?
  total         Float     @default(0)
  note          String?
  order         Int
  isGroupHeader Boolean   @default(false)
  isChargeable  Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_lines")
}

model PaymentMilestone {
  id           String    @id @default(uuid())
  quotationId  String
  no           Int
  title        String
  percent      Float
  description  String?
  /// Ngày dự kiến thanh toán (dùng cho timeline / thời gian biểu)
  expectedDate DateTime?
  order        Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([expectedDate])
  @@map("payment_milestones")
}

model QuotationRevision {
  id              String    @id @default(uuid())
  quotationId     String
  revisionNo      Int
  revisionDate    DateTime
  note            String?
  snapshotJson    String
  totalBeforeVat  Float
  vatAmount       Float
  totalAfterVat   Float
  exportedDocxUrl String?
  exportedPdfUrl  String?
  createdById     String
  createdAt       DateTime  @default(now())
  createdBy       User      @relation(fields: [createdById], references: [id])
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, revisionNo])
  @@index([quotationId])
  @@index([revisionDate])
  @@map("quotation_revisions")
}

/// ================================
/// QUOTATION TEMPLATES
/// ================================

model QuotationTemplate {
  id          String  @id @default(uuid())
  name        String
  code        String? @unique
  description String?

  /// Loại dịch vụ / nhóm: ví dụ BIM_DESIGN, OUTSOURCE,...
  category String?
  isActive Boolean @default(true)

  /// Nội dung chính – tham chiếu cấu trúc Quotation
  title            String  @default("BÁO GIÁ DỊCH VỤ MÔ HÌNH BIM")
  introText        String?
  scopeText        String?
  deliverablesText String  @default("")
  scheduleText     String?

  vatRate Float @default(0.08)

  /// Tuỳ chọn giao diện preview mặc định
  theme          String?
  layoutTemplate String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines             QuotationTemplateLine[]
  paymentMilestones QuotationTemplatePaymentMilestone[]

  @@index([category])
  @@index([createdById])
  @@index([isActive])
  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         String            @id @default(uuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  section       String?
  itemNo        String?
  title         String
  qty           Float?
  unit          String?
  unitPrice     Float?
  total         Float   @default(0)
  note          String?
  order         Int
  isGroupHeader Boolean @default(false)
  isChargeable  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@map("quotation_template_lines")
}

model QuotationTemplatePaymentMilestone {
  id         String            @id @default(uuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  no           Int
  title        String
  percent      Float
  description  String?
  expectedDate DateTime?
  order        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@map("quotation_template_payment_milestones")
}

model CatalogItem {
  id           String   @id @default(uuid())
  category     String
  title        String
  unit         String?
  defaultPrice Float?
  description  String?
  group        String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([group])
  @@map("catalog_items")
}

model Unit {
  id          String   @id @default(uuid())
  name        String   @unique
  symbol      String?
  description String?
  category    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("units")
}

model OutsourcingStaff {
  id              String     @id @default(uuid())
  name            String
  code            String?
  position        String?
  department      String?
  discipline      String?
  avatarUrl       String?
  email           String?
  phone           String?
  address         String?
  companyName     String?
  companyTaxCode  String?
  personalTaxCode String?
  bankAccount     String?
  bankName        String?
  skills          String?
  experience      String?
  certifications  String?
  hourlyRate      Float?
  dailyRate       Float?
  monthlyRate     Float?
  rateType        String?
  isActive        Boolean    @default(true)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  cashFlows       CashFlow[]

  @@index([isActive])
  @@index([code])
  @@map("outsourcing_staff")
}

model Task {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Quan hệ cha - con giữa các công việc (subtask vô hạn)
  parentId     String?
  parent       Task?     @relation("TaskToSubtasks", fields: [parentId], references: [id])
  subtasks     Task[]    @relation("TaskToSubtasks")
  title        String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  /// Hạn hoàn thành công việc – dùng cho logic quá hạn
  dueDate      DateTime?
  status       String    @default("TODO") // TODO, IN_PROGRESS, COMPLETED, DELAYED
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  progress     Int       @default(0) // 0-100
  /// Người chịu trách nhiệm chính
  assignedToId String?
  assignee     User?     @relation("TaskAssignee", fields: [assignedToId], references: [id])
  /// Thứ tự hiển thị (Dùng cho kéo thả Kanban/List)
  order        Float     @default(0)
  /// Giai đoạn triển khai (Khảo sát, Thiết kế, Shopdrawing, Thi công, ...)
  phase        String?
  /// Bộ môn: ARC / STR / MEP / OTHER
  discipline   String?
  /// Vị trí/tầng/khu vực (text tự do)
  location     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([projectId])
  @@index([parentId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([phase])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  fileName     String
  fileUrl      String
  fileSize     Int /// Byte
  mimeType     String?
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([uploadedById])
  @@map("task_attachments")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("MEMBER") // MANAGER, MEMBER, VIEWER
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_members")
}

/// Loại entity có thể gắn trường tuỳ chỉnh
enum CustomFieldEntityType {
  PROJECT
  TASK
}

/// Kiểu dữ liệu của trường tuỳ chỉnh (tham khảo ClickUp: text, number, date, select, multi-select, boolean)
enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  BOOLEAN
}

/// Định nghĩa một trường tuỳ chỉnh cho Project hoặc Task
model CustomField {
  id          String                @id @default(uuid())
  name        String
  key         String                @unique
  description String?
  entityType  CustomFieldEntityType
  fieldType   CustomFieldType
  /// Nhóm/phân loại hiển thị (ví dụ: Thông tin hợp đồng, Vị trí, Kỹ thuật)
  group       String?
  /// Thứ tự hiển thị trong nhóm
  sortOrder   Int                   @default(0)
  /// Trường này có bắt buộc nhập hay không
  isRequired  Boolean               @default(false)
  /// Trường có đang được sử dụng (ẩn/hiện)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  options     CustomFieldOption[]
  values      CustomFieldValue[]

  @@index([entityType])
  @@index([isActive])
  @@map("custom_fields")
}

/// Tuỳ chọn cho các trường dạng SELECT / MULTI_SELECT
model CustomFieldOption {
  id            String      @id @default(uuid())
  customFieldId String
  label         String
  /// Giá trị nội bộ (nếu cần mapping), mặc định dùng giống label
  value         String?
  /// Màu hiển thị (optional), lưu hex hoặc token
  color         String?
  sortOrder     Int         @default(0)
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@index([customFieldId])
  @@map("custom_field_options")
}

/// Giá trị của trường tuỳ chỉnh cho từng entity (Project/Task)
model CustomFieldValue {
  id            String                @id @default(uuid())
  customFieldId String
  /// Loại entity (PROJECT/TASK)
  entityType    CustomFieldEntityType
  /// ID của entity tương ứng (project.id hoặc task.id)
  entityId      String
  /// Lưu giá trị linh hoạt theo kiểu field:
  /// - TEXT / SELECT / MULTI_SELECT: dùng stringValue (MULTI_SELECT có thể là chuỗi JSON của mảng optionId)
  /// - NUMBER: dùng numberValue
  /// - DATE: dùng dateValue
  /// - BOOLEAN: dùng boolValue
  stringValue   String?
  numberValue   Float?
  dateValue     DateTime?
  boolValue     Boolean?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  customField   CustomField           @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  user          User?                 @relation(fields: [userId], references: [id])
  userId        String?

  @@index([customFieldId])
  @@index([entityType, entityId])
  @@map("custom_field_values")
}

/// ================================
/// SYSTEM CONFIG (Key-Value Store)
/// Dùng để lưu cấu hình hệ thống linh hoạt:
/// - permission_overrides: JSON của role permission matrix tùy chỉnh
/// - Các cài đặt hệ thống khác
/// ================================
model SystemConfig {
  id        String   @id @default(uuid())
  /// Khóa duy nhất cho cài đặt, VD: "permission_overrides"
  key       String   @unique
  /// Giá trị lưu dạng JSON string
  value     String   @db.Text
  /// Mô tả mục đích của cài đặt
  label     String?
  updatedAt DateTime @updatedAt
  updatedBy String?  /// email của admin đã cập nhật

  @@map("system_configs")
}

