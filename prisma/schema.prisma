// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  /// Sử dụng SQLite cho local development, Postgres cho production
  /// Giá trị thực của DATABASE_URL được cấu hình qua biến môi trường
  /// Local: file:./prisma/dev.db
  /// Production: postgresql://...
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed
  name      String
  role      String   @default("USER") // ADMIN, USER
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  quotations        Quotation[]
  quotationRevisions QuotationRevision[]
  projects           Project[]
  cashFlows          CashFlow[]
  
  @@map("users")
}

// ============================================
// COMPANY PROFILE (Single record)
// ============================================

model CompanyProfile {
  id Int @id @default(1) // Always 1 - single record
  
  name          String
  taxCode       String
  address       String
  email         String
  website       String?
  phone         String
  logoUrl       String?
  projectSlogan String?
  
  signerName    String  // Người ký
  signerTitle   String  // Chức vụ
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("company_profile")
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id String @id @default(uuid())
  
  name        String
  taxCode     String?
  address     String?
  /// Địa điểm chính của khách hàng (thành phố/tỉnh)
  location    String?
  contactName String?  // Người liên hệ
  email       String?
  phone       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  quotations Quotation[]
  projects   Project[]
  
  @@map("customers")
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id String @id @default(uuid())
  
  // Auto-generated unique number
  projectNo String @unique  // Format: PRJ-2026-0001
  
  // Basic info
  name        String  // Tên dự án
  code        String? // Mã dự án
  description String? // Mô tả dự án
  
  // Customer
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  
  // Project details
  location    String @default("Hà Nội")  // Địa điểm
  startDate   DateTime?  // Ngày bắt đầu
  endDate     DateTime?  // Ngày kết thúc
  totalArea   Float?     // Tổng diện tích (m²)
  
  // Financial summary
  totalBudget     Float @default(0)  // Tổng ngân sách
  totalRevenue    Float @default(0)  // Tổng doanh thu
  totalCost       Float @default(0)  // Tổng chi phí
  totalProfit     Float @default(0)  // Tổng lợi nhuận
  
  // Status
  status String @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, CANCELLED
  
  // Notes
  notes String?

  // Media
  imageUrl String? // Hình ảnh dự án (URL)
  
  // Tracking
  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])
  
  // Finalized quotation (báo giá chốt làm căn cứ)
  finalQuotationId String?   @unique
  finalQuotation   Quotation? @relation("FinalQuotation", fields: [finalQuotationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  quotations Quotation[]
  cashFlows  CashFlow[]
  
  @@map("projects")
  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([projectNo])
}

// ============================================
// CASH FLOWS (Dòng tiền)
// ============================================

model CashFlow {
  id String @id @default(uuid())
  
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Flow info
  type        String  // INCOME (Thu), EXPENSE (Chi)
  category    String? // Loại: Thu từ báo giá, Chi phí outsource, Chi phí khác...
  description String  // Mô tả
  
  // Amount
  amount      Float   // Số tiền
  
  // Date
  date        DateTime // Ngày phát sinh
  
  // Reference
  quotationId String? // Liên kết với Quotation nếu có
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  
  // Structured info for contract payments & outsource payouts
  // - INCOME: store payment milestone info (đợt thanh toán)
  paymentMilestoneNo      Int?
  paymentMilestonePercent Float?
  paymentMilestoneTitle   String?

  // - EXPENSE: store outsource counterparty (nhân sự/đơn vị) info
  outsourcingStaffId String?
  outsourcingStaff   OutsourcingStaff? @relation(fields: [outsourcingStaffId], references: [id])
  counterpartyName   String?

  // Notes
  notes String?
  /// Tình trạng hồ sơ thanh toán cho đợt thu/chi này
  /// Giá trị gợi ý: NONE | SUBMITTED | APPROVED | REJECTED
  documentStatus String?
  /// Ghi chú chi tiết về hồ sơ (số hóa đơn, nội dung bổ sung...)
  documentNote   String?
  
  // Tracking
  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("cash_flows")
  @@index([projectId])
  @@index([date])
  @@index([type])
  @@index([quotationId])
  @@index([outsourcingStaffId])
}

// ============================================
// QUOTATIONS
// ============================================

model Quotation {
  id String @id @default(uuid())
  
  // Auto-generated unique number
  quotationNo String @unique  // Format: BG-2026-0001
  
  // Project relation
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Basic info
  date        DateTime
  location    String @default("Hà Nội")  // Địa điểm
  
  // Customer (redundant but kept for compatibility)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  
  // Project info (redundant but kept for compatibility)
  projectName        String
  projectItem        String?  // Hạng mục
  projectNotes       String?  // Ghi chú thêm
  totalArea          Float?   // Tổng diện tích (m2) - dùng cho báo giá theo diện tích
  
  // Title & intro
  title             String @default("BÁO GIÁ DỊCH VỤ MÔ HÌNH BIM")
  introText         String?  // Đoạn mở đầu cảm ơn
  
  // Scope & deliverables
  scopeText         String?  // Phạm vi công việc (bao gồm...)
  deliverablesText  String @default("")  // Sản phẩm bàn giao (rich text/HTML)
  
  // Schedule
  scheduleText      String?  // Tiến độ thực hiện
  
  // Financial
  currency          String @default("VND")
  vatRate           Float @default(0.08)  // 8% default
  totalBeforeVat    Float @default(0)
  vatAmount         Float @default(0)
  totalAfterVat     Float @default(0)
  totalInWords      String?  // Tổng bằng chữ
  
  // Cost calculation (internal use, not shown in preview)
  outsourceCost     Float?  // Chi phí outsource
  outsourceStaff    String? // Nhân sự / đơn vị outsource chính
  outsourceDiscipline String? // Bộ môn / chuyên ngành outsource
  outsourceRate     Float?  // Đơn giá outsource (theo giờ/gói)
  outsourceNote     String? // Ghi chú chi tiết về outsource
  taxRate           Float?  // Tỷ lệ thuế (%)
  taxCost           Float?  // Chi phí thuế (tự động tính)
  commissionType    String? // Loại hoa hồng: 'direct' hoặc 'percentage'
  commissionRate    Float?  // Tỷ lệ hoa hồng (%)
  commissionCost    Float?  // Chi phí hoa hồng
  
  // Status
  status String @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  
  // Notes
  notes String?
  
  // Tracking
  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  lines             QuotationLine[]
  outsourceLines    QuotationOutsourceLine[]
  paymentMilestones PaymentMilestone[]
  revisions         QuotationRevision[]
  cashFlows         CashFlow[]

  // Reverse relation for Project.finalQuotation
  finalForProject   Project? @relation("FinalQuotation")
  
  @@map("quotations")
  @@index([projectId])
  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([quotationNo])
}

// ============================================
// OUTSOURCE COST LINES (Chi tiết chi phí outsource)
// ============================================

model QuotationOutsourceLine {
  id String @id @default(uuid())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  staffName  String? // Nhân sự / đơn vị
  discipline String? // Bộ môn
  unit       String? // Đơn vị (giờ/ngày/tháng/gói)
  qty        Float?  // Khối lượng
  unitRate   Float?  // Đơn giá
  amount     Float   @default(0) // Thành tiền
  note       String?
  order      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quotation_outsource_lines")
  @@index([quotationId])
}


// ============================================
// QUOTATION LINES (Pricing Table)
// ============================================

model QuotationLine {
  id String @id @default(uuid())
  
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  // Line info
  section       String?   // e.g., "A - PHẠM VI CÔNG VIỆC", "B - BÁO GIÁ"
  itemNo        String?   // e.g., "1", "1.1", "2.3"
  title         String    // Nội dung công việc
  
  // Quantities
  qty           Float?    // Khối lượng CV (null for lumpsum)
  unit          String?   // e.g., "m²", "gói", "bộ"
  unitPrice     Float?    // Đơn giá
  
  // Calculated
  total         Float @default(0)  // Thành tiền
  
  // Metadata
  note          String?
  order         Int       // Display order
  isGroupHeader Boolean @default(false)  // Is this a group header row?
  isChargeable  Boolean @default(true)   // Include in total calculation?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("quotation_lines")
  @@index([quotationId])
}

// ============================================
// PAYMENT MILESTONES
// ============================================

model PaymentMilestone {
  id String @id @default(uuid())
  
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  no          Int     // STT
  title       String  // Nội dung
  percent     Float   // Tỉ lệ %
  description String? // Mô tả thêm
  /// Ngày dự kiến thanh toán (dùng cho timeline / thời gian biểu)
  expectedDate DateTime?
  
  order       Int     // Display order
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("payment_milestones")
  @@index([quotationId])
  @@index([expectedDate])
}

// ============================================
// REVISION / VERSION HISTORY
// ============================================

model QuotationRevision {
  id String @id @default(uuid())
  
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  // Version info
  revisionNo   Int       // Auto-increment per quotation
  revisionDate DateTime  // Date of this version
  note         String?   // Optional version note
  
  // Snapshot
  snapshotJson String    // Full JSON snapshot of quotation + lines + milestones
  
  // Financial snapshot
  totalBeforeVat Float
  vatAmount      Float
  totalAfterVat  Float
  
  // Export files
  exportedDocxUrl String?
  exportedPdfUrl  String?
  
  // Tracking
  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])
  
  createdAt DateTime @default(now())
  
  @@map("quotation_revisions")
  @@index([quotationId])
  @@index([revisionDate])
  @@unique([quotationId, revisionNo])
}

// ============================================
// CATALOG / MASTER DATA
// ============================================

model CatalogItem {
  id String @id @default(uuid())
  
  category      String    // SCOPE, DELIVERABLES, PRICING
  title         String    // Nội dung
  unit          String?   // Đơn vị (cho PRICING)
  defaultPrice  Float?    // Đơn giá mặc định (cho PRICING)
  description   String?   // Mô tả thêm (HTML/RichText for deliverables)
  group         String?   // Nhóm dịch vụ (VD: "Mô hình BIM", "Phân tích", "Bản vẽ")
  
  order         Int       @default(0)
  isActive      Boolean   @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("catalog_items")
  @@index([category])
  @@index([group])
}

// ============================================
// UNITS (Đơn vị)
// ============================================

model Unit {
  id String @id @default(uuid())
  
  name        String  @unique // Tên đơn vị (VD: "m²", "gói", "bộ", "giờ")
  symbol      String? // Ký hiệu (nếu khác với name)
  description String? // Mô tả đơn vị
  category    String? // Loại đơn vị: AREA (diện tích), VOLUME (thể tích), COUNT (số lượng), TIME (thời gian), PACKAGE (gói), OTHER
  
  order       Int     @default(0)
  isActive    Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("units")
  @@index([category])
  @@index([isActive])
}

// ============================================
// OUTSOURCING STAFF
// ============================================

model OutsourcingStaff {
  id String @id @default(uuid())
  
  // Basic info
  name          String   // Tên nhân sự
  code          String?  // Mã nhân sự
  position      String?  // Chức vụ/Vị trí
  department    String?  // Phòng ban
  discipline    String?  // Bộ môn
  avatarUrl     String?  // URL ảnh đại diện
  
  // Contact
  email         String?
  phone         String?
  address       String?  // Địa chỉ
  
  // Company info
  companyName   String?  // Tên công ty outsource
  companyTaxCode String? // Mã số thuế công ty
  
  // Personal info
  personalTaxCode String? // Mã số thuế cá nhân
  bankAccount     String? // Số tài khoản ngân hàng
  bankName        String? // Tên ngân hàng
  
  // Skills & Expertise
  skills        String?  // Kỹ năng chuyên môn (comma-separated hoặc JSON)
  experience    String?  // Kinh nghiệm
  certifications String? // Chứng chỉ
  
  // Rate & Cost
  hourlyRate    Float?   // Giá theo giờ (VNĐ)
  dailyRate     Float?   // Giá theo ngày (VNĐ)
  monthlyRate   Float?   // Giá theo tháng (VNĐ)
  rateType      String?  // Loại giá: hourly, daily, monthly
  
  // Status
  isActive      Boolean  @default(true)
  notes         String?  // Ghi chú
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cashFlows CashFlow[]
  
  @@map("outsourcing_staff")
  @@index([isActive])
  @@index([code])
}
