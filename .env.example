# ============================================
# DATABASE (Neon PostgreSQL - BẮT BUỘC)
# ============================================
# Lấy từ Neon Console: https://console.neon.tech
# 
# Pooled connection (cho app queries - dùng ở cả dev & prod):
DATABASE_URL="postgresql://user:password@ep-xxx-yyy.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection (cho Prisma migrations):
DIRECT_URL="postgresql://user:password@ep-xxx-yyy.region.aws.neon.tech/neondb?sslmode=require"

# ============================================
# NEXTAUTH (BẮT BUỘC)
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

AZURE_AD_CLIENT_ID="your-azure-ad-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
AZURE_AD_TENANT_ID="common" 

# ============================================
# APP (Tùy chọn)
# ============================================
NEXT_PUBLIC_APP_NAME="Quotation Management System"
NEXT_PUBLIC_COMPANY_NAME="BIM Company"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# EMAIL - Resend (Tùy chọn)
# ============================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
ADMIN_EMAIL="admin@yourdomain.com"

# ============================================
# AI Services (Tùy chọn)
# ============================================
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: Claude API for Phase 04 chatbot
CLAUDE_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
